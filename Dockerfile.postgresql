FROM icr.io/appcafe/open-liberty:kernel-slim-java17-openj9-ubi

# Liberty config: PostgreSQL flavour of server.xml (DB settings come from environment variables at run time)
COPY --chown=1001:0 src/main/liberty/config/server.xml_postgresql /config/server.xml
COPY --chown=1001:0 target/io.openliberty.sample.daytrader10.war /config/apps/

# PostgreSQL JDBC driver (copied to target/ by 'mvn package')
COPY --chown=1001:0 target/liberty/wlp/usr/shared/resources/PostgresLibs/postgresql-42.7.3.jar /opt/ol/wlp/usr/shared/resources/PostgresLibs/postgresql-42.7.3.jar

# Install the Liberty features listed in server.xml, then warm up the shared class cache
RUN features.sh
RUN configure.sh
